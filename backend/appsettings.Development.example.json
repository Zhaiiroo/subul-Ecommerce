{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:3001"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=subul-Ecommerce;Username=subul;Password=SAME_AS_POSTGRES_PASSWORD_IN_.env.development;Pooling=true;Minimum Pool Size=1;Maximum Pool Size=100;",
    "Redis": "localhost:6379,password=SAME_AS_REDIS_PASSWORD_IN_.env.development,abortConnect=false"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_LOCAL_SECRET_OF_AT_LEAST_32_CHARACTERS",
    "Issuer": "subul-admin",
    "Audience": "subul-admin-panel",
    "AccessTokenMinutes": 480
  },
  "AdminBootstrap": {
    "Enabled": false
  }
}
