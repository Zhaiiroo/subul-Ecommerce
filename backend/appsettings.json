{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ImageStorage": {
    "Provider": "Local",
    "MaxFileSizeBytes": 5242880,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".webp",
      ".gif"
    ]
  },
  "RequestLimits": {
    "MaxJsonBodyBytes": 262144
  },
  "RedisRateLimit": {
    "Enabled": true,
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 300
  },
  "AdminBootstrap": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:3001"
    ]
  },
  "Jwt": {
    "Issuer": "subul-admin",
    "Audience": "subul-admin-panel",
    "AccessTokenMinutes": 480
  }
}
