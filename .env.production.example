APP_ENVIRONMENT=Production
IMAGE_TAG=REPLACE_WITH_A_RELEASE_TAG

POSTGRES_DB=subul
POSTGRES_USER=subul
POSTGRES_PASSWORD=REPLACE_WITH_A_PRODUCTION_DATABASE_PASSWORD
POSTGRES_VOLUME_NAME=subul-production-postgres
DATABASE_BACKUP_PATH=/srv/subul/backups/database

# Letters and digits only: the value is embedded in a StackExchange.Redis
# connection string, where `,` and `=` are separators.
REDIS_PASSWORD=REPLACE_WITH_A_PRODUCTION_REDIS_PASSWORD
REDIS_CACHE_PASSWORD=REPLACE_WITH_A_PRODUCTION_CACHE_PASSWORD

# Distinct per environment. TRAEFIK_IPV4 must sit inside the subnet; it is the
# only address the API trusts for X-Forwarded-For.
SUBUL_NETWORK_SUBNET=172.30.30.0/24
TRAEFIK_IPV4=172.30.30.10

PUBLIC_SITE_URL=https://example.com
PUBLIC_API_URL=https://example.com/api
INTERNAL_API_URL=http://api:5101/api
INTERNAL_API_ORIGIN=http://api:5101
ADMIN_ORIGIN=https://admin.example.com
STOREFRONT_ORIGIN=https://example.com
# Public hosts the API answers to, plus `api` for in-network calls.
API_ALLOWED_HOSTS=example.com;admin.example.com;api

JWT_SECRET=REPLACE_WITH_A_PRODUCTION_SECRET_AT_LEAST_32_CHARACTERS
JWT_ISSUER=subul-admin
JWT_AUDIENCE=subul-admin-panel
JWT_ACCESS_TOKEN_MINUTES=480
AUTH_SECRET=REPLACE_WITH_A_PRODUCTION_AUTH_SECRET

ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_NAME=Administrator
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=

R2_SERVICE_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=subul-production-media
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
PUBLIC_IMAGE_URL=https://media.example.com

