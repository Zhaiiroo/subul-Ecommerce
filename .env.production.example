APP_ENVIRONMENT=Production
# IMAGE_TAG is not set here: the `subul` wrapper takes it from the installed
# release, so switching or rolling back releases never edits this file.

POSTGRES_DB=subul
POSTGRES_USER=subul
POSTGRES_PASSWORD=REPLACE_WITH_A_PRODUCTION_DATABASE_PASSWORD
POSTGRES_VOLUME_NAME=subul-production-postgres
DATABASE_BACKUP_PATH=/srv/subul/backups/database
# rclone remote for off-server copies of every backup, e.g. r2-backups:subul
# (a PRIVATE bucket). Empty = backups stay on this disk only; download them.
BACKUP_OFFSITE_REMOTE=

# Letters and digits only: the value is embedded in a StackExchange.Redis
# connection string, where `,` and `=` are separators.
REDIS_PASSWORD=REPLACE_WITH_A_PRODUCTION_REDIS_PASSWORD
REDIS_CACHE_PASSWORD=REPLACE_WITH_A_PRODUCTION_CACHE_PASSWORD

# One /24 per environment, written as its first three octets. Fixed addresses
# inside it: .10 traefik, .11 storefront, .12 admin — the only callers the API
# trusts for X-Forwarded-For.
SUBUL_NETWORK_PREFIX=172.30.30

# Until the domain exists, use the server IP with dashes under sslip.io, which
# resolves <a-b-c-d>.sslip.io to a.b.c.d with no registration. Let's Encrypt
# issues real certificates for these names. Moving to the domain later means
# changing these three lines and rebuilding once (PUBLIC_SITE_URL is compiled
# into the storefront for canonical and Open Graph URLs).
STORE_HOST=203-0-113-10.sslip.io
ADMIN_HOST=admin.203-0-113-10.sslip.io
PUBLIC_SITE_URL=https://203-0-113-10.sslip.io

JWT_SECRET=REPLACE_WITH_A_PRODUCTION_SECRET_AT_LEAST_32_CHARACTERS
JWT_ISSUER=subul-admin
JWT_AUDIENCE=subul-admin-panel
JWT_ACCESS_TOKEN_MINUTES=480
AUTH_SECRET=REPLACE_WITH_A_PRODUCTION_AUTH_SECRET

ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_NAME=Administrator
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=

# Local: uploads are written to UPLOADS_PATH on the host (owned by UID 1654).
# R2: set the five R2 values below; PUBLIC_IMAGE_URL is the bucket's custom
# domain, which needs the final domain on Cloudflare, and the frontends must be
# rebuilt with it. Leave them empty while the provider is Local.
IMAGE_STORAGE_PROVIDER=Local
UPLOADS_PATH=/srv/subul/img

R2_SERVICE_URL=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
PUBLIC_IMAGE_URL=

