# Development runs the applications natively and only PostgreSQL/Redis in Docker.
POSTGRES_DB=subul-Ecommerce
POSTGRES_USER=subul
POSTGRES_PASSWORD=DEVELOPMENT_ONLY_PASSWORD
POSTGRES_VOLUME_NAME=subul-development-postgres
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
DATABASE_BACKUP_PATH=./backups/database

# Letters and digits only: the value is embedded in a StackExchange.Redis
# connection string, where `,` and `=` are separators.
REDIS_PASSWORD=DevelopmentOnlyRedisPassword
REDIS_CACHE_PASSWORD=DevelopmentOnlyCachePassword

# One /24 per environment, written as its first three octets. Fixed addresses
# inside it: .10 traefik, .11 storefront, .12 admin — the only callers the API
# trusts for X-Forwarded-For.
SUBUL_NETWORK_PREFIX=172.30.10

# Compose validates every service, including the ones Development never starts.
STORE_HOST=localhost
ADMIN_HOST=admin.localhost
PUBLIC_SITE_URL=http://localhost:3001

