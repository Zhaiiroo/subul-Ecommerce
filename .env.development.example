# Development runs the applications natively and only PostgreSQL/Redis in Docker.
POSTGRES_DB=subul-Ecommerce
POSTGRES_USER=subul
POSTGRES_PASSWORD=DEVELOPMENT_ONLY_PASSWORD
POSTGRES_VOLUME_NAME=subul-development-postgres
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
DATABASE_BACKUP_PATH=./backups/database

