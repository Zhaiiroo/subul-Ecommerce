# Values compiled into the frontend images when a release is built with
# deploy/scripts/release-export.sh. Copy to .env.release (ignored by Git).
# No secrets belong here: this file only names the public hosts.
#
# They must match /etc/subul/production.env on the server. A change of host
# (the move from sslip.io to the final domain) therefore means a new release.

STORE_HOST=203-0-113-10.sslip.io
ADMIN_HOST=admin.203-0-113-10.sslip.io
PUBLIC_SITE_URL=https://203-0-113-10.sslip.io

# Empty while images are stored locally; the R2 custom domain afterwards.
PUBLIC_IMAGE_URL=
