APP_ENVIRONMENT=Staging
IMAGE_TAG=staging

POSTGRES_DB=subul-Staging
POSTGRES_USER=subul
POSTGRES_PASSWORD=STAGING_ONLY_PASSWORD
POSTGRES_VOLUME_NAME=subul-staging-postgres
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6380
DATABASE_BACKUP_PATH=./backups/database

# Letters and digits only: the value is embedded in a StackExchange.Redis
# connection string, where `,` and `=` are separators.
REDIS_PASSWORD=REPLACE_WITH_A_STAGING_REDIS_PASSWORD
REDIS_CACHE_PASSWORD=REPLACE_WITH_A_STAGING_CACHE_PASSWORD

# Distinct per environment. TRAEFIK_IPV4 must sit inside the subnet; it is the
# only address the API trusts for X-Forwarded-For.
SUBUL_NETWORK_SUBNET=172.30.20.0/24
TRAEFIK_IPV4=172.30.20.10

STOREFRONT_HOST_PORT=8080
ADMIN_HOST_PORT=3100
HTTPS_HOST_PORT=8443
PUBLIC_SITE_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:8080/api
INTERNAL_API_URL=http://api:5101/api
INTERNAL_API_ORIGIN=http://api:5101
ADMIN_ORIGIN=http://localhost:3100
STOREFRONT_ORIGIN=http://localhost:8080

LOCAL_UPLOADS_PATH=./.runtime/staging/img

JWT_SECRET=REPLACE_WITH_A_STAGING_SECRET_AT_LEAST_32_CHARACTERS
JWT_ISSUER=subul-admin
JWT_AUDIENCE=subul-admin-panel
JWT_ACCESS_TOKEN_MINUTES=480
AUTH_SECRET=REPLACE_WITH_A_STAGING_AUTH_SECRET

ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_NAME=Administrator
ADMIN_BOOTSTRAP_EMAIL=admin@staging.local
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_STAGING_ADMIN_PASSWORD

